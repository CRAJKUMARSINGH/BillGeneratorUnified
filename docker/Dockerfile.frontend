# Stage 1: Build
FROM node:20-slim as builder

WORKDIR /app

COPY frontend/package*.json ./
RUN npm install

COPY frontend/ .
RUN npm run build

# Stage 2: Runtime
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY docker/Caddyfile /etc/caddy/Caddyfile 

# Note: Using Nginx here but plan mentioned Caddy. 
# For now, standard Nginx is simpler for the build stage.
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
